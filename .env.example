# .env.example
# Copy to .env.local and fill in your values

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/school_signage"

# JWT secret — use a long random string in production
# Generate: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# File storage (local for dev, use S3/Cloudflare R2 in production)
STORAGE_PROVIDER="local"
LOCAL_UPLOADS_DIR="./public/uploads"
NEXT_PUBLIC_UPLOADS_BASE_URL="/uploads"

# For cloud storage (optional)
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Weather API (optional, for weather widget)
# OPENWEATHER_API_KEY=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
