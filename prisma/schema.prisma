// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  EDITOR
  VIEWER
}
enum Orientation {
  LANDSCAPE
  PORTRAIT
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}
enum MediaType {
  IMAGE
  VIDEO
}
enum ContentType {
  TEXT
  IMAGE_GALLERY
  VIDEO
  CLOCK
  DATE
  WEATHER
  RSS_FEED
  TIMETABLE
  EVENTS
  BIRTHDAYS
  ANNOUNCEMENT
  EMPTY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sessions     Session[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@map("sessions")
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  weatherCity String?
  locale    String   @default("he")
  timezone  String   @default("Asia/Jerusalem")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  screens       Screen[]
  announcements Announcement[]
  mediaFiles    MediaFile[]
  galleries     Gallery[]
  messages      Message[]
  theme         SchoolTheme?
  @@map("schools")
  
}

model SchoolTheme {
  id              String  @id @default(cuid())
  schoolId        String  @unique
  school          School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  primaryColor    String  @default("#1a73e8")
  secondaryColor  String  @default("#ffffff")
  backgroundColor String  @default("#0f0f1a")
  fontFamily      String  @default("Heebo")
  logoUrl         String?
  borderRadius    Int     @default(8)
  @@map("school_themes")
}

model Screen {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  slug        String      @unique
  shortCode   String?     @unique
  orientation Orientation @default(LANDSCAPE)
  width       Int         @default(1920)
  height      Int         @default(1080)
  active      Boolean     @default(true)
  refreshSecs Int         @default(30)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  layout        ScreenLayout?
  sections      ScreenSection[]
  announcements AnnouncementScreen[]
  @@map("screens")
}

model ScreenLayout {
  id       String @id @default(cuid())
  screenId String @unique
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  // Header — NEW: height + date type
  headerEnabled    Boolean @default(true)
  headerHeight     Int     @default(80)        // px — 60/80/100/120
  headerShowLogo   Boolean @default(true)
  headerShowTitle  Boolean @default(true)
  headerShowClock  Boolean @default(true)
  headerShowDate   Boolean @default(true)
  headerShowHebDate Boolean @default(true)
  headerDateType   String  @default("BOTH")    // HEBREW | GREGORIAN | BOTH
  headerShowWeather Boolean @default(false)
  headerScrollText String?
  headerTitleFontSize   Int @default(26)
  headerTitleFontWeight Int @default(700)
  headerShowParasha Boolean @default(false)

  mainSections Int @default(1)

  // Footer — NEW: height + birthdays
  footerEnabled        Boolean @default(true)
  footerHeight         Int     @default(48)    // px — 40/48/60/72
  footerTicker         String?
  footerShowSchoolName Boolean @default(true)
  footerShowClock      Boolean @default(false)
  footerShowBirthdays  Boolean @default(false)
  footerFeedMode         String @default("manual")
  footerRssUrl           String?
  footerRssMaxItems      Int    @default(8)
  footerRssRefreshMinutes Int   @default(15)
  footerTickerSpeed      String @default("normal")

  bgColor    String?
  bgImageUrl String?
  fontFamily String @default("Heebo")
  @@map("screen_layouts")
}

model ScreenSection {
  id       String @id @default(cuid())
  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  position Int
  widthPct Int    @default(100)

  contentItems ContentItem[]
  @@unique([screenId, position])
  @@map("screen_sections")
}

model ContentItem {
  id          String        @id @default(cuid())
  sectionId   String
  section     ScreenSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contentType ContentType   @default(TEXT)
  priority    Int           @default(0)
  active      Boolean       @default(true)

  startDate DateTime?
  endDate   DateTime?
  startTime String?
  endTime   String?
  daysOfWeek Int[]

  textContent     String?
  textColor       String?
  bgColor         String?
  fontSize        Int?

  galleryId       String?
  gallery         Gallery?  @relation(fields: [galleryId], references: [id])
  slideDuration   Int       @default(5)
  transitionStyle String    @default("fade")

  videoUrl  String?
  videoLoop Boolean @default(true)
  videoMuted Boolean @default(true)

  rssUrl      String?
  rssMaxItems Int     @default(5)

  weatherCity  String?
  weatherUnits String  @default("metric")

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("content_items")
}

model Announcement {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  priority    Priority @default(LOW)
  bgColor     String   @default("#1a1a2e")
  textColor   String   @default("#ffffff")
  icon        String?
  active      Boolean  @default(true)
  startAt     DateTime
  endAt       DateTime
  startTime   String?
  endTime     String?
  daysOfWeek  Int[]
  isEmergency Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  screens AnnouncementScreen[]
  @@map("announcements")
}

model AnnouncementScreen {
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  screenId        String
  screen          Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  sectionPosition Int?
  @@id([announcementId, screenId])
  @@map("announcement_screens")
}

// NEW: Messages — simple text messages for content editor
model Message {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  body      String
  priority  String   @default("info")  // info | warning | urgent
  icon      String   @default("📢")
  bgColor   String   @default("#1e3a5f")
  textColor String   @default("#ffffff")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("messages")
}

model MediaFile {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  galleryId    String?
  gallery      Gallery?  @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  filename     String
  originalName String
  mimeType     String
  size         Int
  mediaType    MediaType
  url          String
  caption      String?
  hidden       Boolean   @default(false)
  uploadedAt   DateTime  @default(now())
  @@map("media_files")
}

// Gallery = album/folder for images
model Gallery {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  files        MediaFile[]
  contentItems ContentItem[]
  @@map("galleries")
}
