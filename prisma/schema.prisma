// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  EDITOR
  VIEWER
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContentType {
  TEXT
  IMAGE_GALLERY
  VIDEO
  CLOCK
  DATE
  WEATHER
  RSS_FEED
  TIMETABLE
  EVENTS
  BIRTHDAYS
  ANNOUNCEMENT
  IFRAME
  EMPTY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model School {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  weatherCity String?
  locale      String   @default("he")
  timezone    String   @default("Asia/Jerusalem")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  screens       Screen[]
  announcements Announcement[]
  mediaFiles    MediaFile[]
  galleries     Gallery[]
  theme         SchoolTheme?
  people        Person[]
  personSources PersonSource[]

  @@map("schools")
}

model SchoolTheme {
  id              String  @id @default(cuid())
  schoolId        String  @unique
  school          School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  primaryColor    String  @default("#1a73e8")
  secondaryColor  String  @default("#ffffff")
  backgroundColor String  @default("#0f0f1a")
  fontFamily      String  @default("Heebo")
  logoUrl         String?
  borderRadius    Int     @default(8)

  @@map("school_themes")
}

model Screen {
  id                String                   @id @default(cuid())
  schoolId          String
  school            School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  slug              String                   @unique
  shortCode         String?                  @unique
  orientation       Orientation              @default(LANDSCAPE)
  width             Int                      @default(1920)
  height            Int                      @default(1080)
  active            Boolean                  @default(true)
  refreshSecs       Int                      @default(300)
  // Last snapshot captured in the screen editor ("עדכן צילום"): a versioned image URL and when it
  // was taken. Both empty until the first capture; the screens list falls back to the schematic.
  snapshotUrl       String?
  snapshotAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  operatingSchedule ScreenOperatingSchedule?
  pairingCodes      ScreenPairingCode[]

  layout        ScreenLayout?
  sections      ScreenSection[]
  announcements AnnouncementScreen[]

  @@map("screens")
}

model ScreenLayout {
  id       String @id @default(cuid())
  screenId String @unique
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  // Header — NEW: height + date type
  headerEnabled         Boolean @default(true)
  headerHeight          Int     @default(80) // px — 60/80/100/120
  headerShowLogo        Boolean @default(true)
  headerShowTitle       Boolean @default(true)
  headerShowClock       Boolean @default(true)
  headerShowDate        Boolean @default(true)
  headerShowHebDate     Boolean @default(true)
  headerDateType        String  @default("BOTH") // HEBREW | GREGORIAN | BOTH
  headerShowWeather     Boolean @default(false)
  headerScrollText      String?
  headerTitleFontSize   Int     @default(26)
  headerTitleFontWeight Int     @default(700)
  headerShowParasha     Boolean @default(false)

  mainSections Int @default(1)

  // Footer — NEW: height + birthdays
  footerEnabled           Boolean @default(true)
  footerHeight            Int     @default(48) // px — 40/48/60/72
  footerTicker            String?
  footerShowSchoolName    Boolean @default(true)
  footerShowClock         Boolean @default(false)
  footerShowBirthdays     Boolean @default(false)
  footerFeedMode          String  @default("manual")
  footerRssUrl            String?
  footerRssMaxItems       Int     @default(8)
  footerRssRefreshMinutes Int     @default(15)
  footerTickerSpeed       String  @default("normal")

  bgColor    String?
  bgImageUrl String?
  fontFamily String  @default("Heebo")

  @@map("screen_layouts")
}

model ScreenSection {
  id       String @id @default(cuid())
  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  position Int
  widthPct Int    @default(100)

  contentItems ContentItem[]

  @@unique([screenId, position])
  @@map("screen_sections")
}

model ContentItem {
  id          String        @id @default(cuid())
  sectionId   String
  section     ScreenSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contentType ContentType   @default(TEXT)
  priority    Int           @default(0)
  active      Boolean       @default(true)

  startDate  DateTime?
  endDate    DateTime?
  startTime  String?
  endTime    String?
  daysOfWeek Int[]

  textContent String?
  textColor   String?
  bgColor     String?
  fontSize    Int?

  galleryId       String?
  gallery         Gallery? @relation(fields: [galleryId], references: [id])
  slideDuration   Int      @default(5)
  transitionStyle String   @default("fade")

  videoUrl   String?
  videoLoop  Boolean @default(true)
  videoMuted Boolean @default(true)

  rssUrl      String?
  rssMaxItems Int     @default(5)

  weatherCity  String?
  weatherUnits String  @default("metric")

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("content_items")
}

model Announcement {
  id                     String   @id @default(cuid())
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title                  String
  showTitle              Boolean  @default(true)
  body                   String
  priority               Priority @default(LOW)
  bgColor                String   @default("#1a1a2e")
  textColor              String   @default("#ffffff")
  icon                   String?
  attachmentDisplayMode  String   @default("slideshow") // together | slideshow
  attachmentSlideSeconds Int      @default(8)
  active                 Boolean  @default(true)
  startAt                DateTime
  endAt                  DateTime
  startTime              String?
  endTime                String?
  daysOfWeek             Int[]
  isEmergency            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  screens     AnnouncementScreen[]
  attachments AnnouncementAttachment[]

  @@map("announcements")
}

// Attachments belong to announcements, not the general media gallery.
// A PDF's display pages are stored as separate IMAGE entries with parentPdfId.
model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  kind           String // IMAGE | PDF | PDF_PAGE
  url            String
  originalName   String
  mimeType       String
  sortOrder      Int          @default(0)
  parentPdfId    String?
  createdAt      DateTime     @default(now())

  @@index([announcementId, sortOrder])
  @@map("announcement_attachments")
}

model AnnouncementScreen {
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  screenId        String
  screen          Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  sectionPosition Int?

  @@id([announcementId, screenId])
  @@map("announcement_screens")
}

model MediaFile {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  galleryId    String?
  gallery      Gallery?  @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  filename     String
  originalName String
  mimeType     String
  size         Int
  mediaType    MediaType
  url          String
  caption      String?
  hidden       Boolean   @default(false)
  uploadedAt   DateTime  @default(now())

  @@map("media_files")
}

// Gallery = album/folder for images
model Gallery {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files        MediaFile[]
  contentItems ContentItem[]

  @@map("galleries")
}

model ScreenOperatingSchedule {
  screenId    String   @id
  enabled     Boolean  @default(false)
  startTime   String   @default("07:00")
  endTime     String   @default("19:00")
  days        Int[]    @default([0, 1, 2, 3, 4])
  standbyMode String   @default("logo")
  updatedAt   DateTime @default(now()) @updatedAt

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@map("ScreenOperatingSchedule")
}

model ScreenPairingCode {
  id        String    @id @default(cuid())
  screenId  String
  screen    Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([screenId, expiresAt])
  @@map("screen_pairing_codes")
}

model PairingRateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime

  @@map("pairing_rate_limits")
}

// ── Birthday management ─────────────────────────────────────────────────────────────────────────
// People of a school (students and teachers) whose birthdays may be shown on screens. Personal data,
// including minors: managed only by SCHOOL_ADMIN and up, always scoped to one school, never sent to
// public screens as is (see src/lib/people/*).

enum PersonRoleType {
  STUDENT
  TEACHER
}

enum PersonGender {
  MALE
  FEMALE
}

/// Where a person's data comes from. Precedence for imports: SMARTSCHOOL > EXCEL > MANUAL.
enum PersonSourceType {
  MANUAL
  EXCEL
  SMARTSCHOOL
}

enum PersonSourceStatus {
  ACTIVE
  MISSING
  INACTIVE
}

model Person {
  id                 String           @id @default(cuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  /// Date only (no time, no time zone). Read with UTC getters; the year is internal only.
  birthDate          DateTime         @db.Date
  gender             PersonGender?
  /// Keyed HMAC-SHA256 of the normalized external identifier (e.g. ת״ז), scoped to the school.
  /// The raw identifier is never stored. Null for people added without an identifier.
  identityKey        String?
  identityKeyVersion Int?
  /// The identifier's last 3 characters, so admins can tell people with the same name apart.
  identityHint       String?
  active             Boolean          @default(true)
  deactivatedAt      DateTime?
  /// The source that last wrote the core fields (names, birth date, gender); see sourcePrecedence.
  dataSource         PersonSourceType @default(MANUAL)
  lastSyncedAt       DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  roles   PersonRole[]
  sources PersonSource[]

  @@unique([schoolId, identityKey])
  @@index([schoolId, active])
  @@index([schoolId, lastName, firstName])
  @@map("people")
}

/// A person's role in the school. One row per role, so a person can be both student and teacher
/// (or change role) without being duplicated.
model PersonRole {
  id        String         @id @default(cuid())
  personId  String
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      PersonRoleType
  /// Students: canonical grade (e.g. "ט׳"), parallel number and display class (e.g. "ט׳ 2").
  grade     String?
  parallel  Int?
  className String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([personId, role])
  @@index([role, grade])
  @@map("person_roles")
}

/// A record of a person in one data source. recordKey identifies the record within the source:
/// "manual:<personId>" for manual entries, a keyed HMAC of the source's record identifier otherwise.
model PersonSource {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  personId       String
  person         Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  sourceType     PersonSourceType
  recordKey      String
  status         PersonSourceStatus @default(ACTIVE)
  lastSeenAt     DateTime?
  lastImportedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([schoolId, sourceType, recordKey])
  @@index([personId])
  @@map("person_sources")
}
