// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  EDITOR
  VIEWER
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContentType {
  TEXT
  IMAGE_GALLERY
  VIDEO
  CLOCK
  DATE
  WEATHER
  RSS_FEED
  TIMETABLE
  EVENTS
  BIRTHDAYS
  ANNOUNCEMENT
  IFRAME
  DUTY_ROSTER
  EMPTY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  /// Duty roster access (see DutyAccess), separate from the screen role.
  dutyAccess   DutyAccess @default(NONE)
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model School {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  weatherCity String?
  locale      String   @default("he")
  timezone    String   @default("Asia/Jerusalem")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  screens       Screen[]
  announcements Announcement[]
  mediaFiles    MediaFile[]
  galleries     Gallery[]
  theme         SchoolTheme?
  people        Person[]
  personSources PersonSource[]
  personAudit   PersonAuditEvent[]
  personImports PersonImport[]
  dutyStaff     DutyStaff[]
  dutyLocations DutyLocation[]
  dutyPeriods   DutyPeriod[]
  dutySettings  DutySettings?
  dutyWeeks     DutyWeek[]
  dutyTemplates DutyTemplate[]
  dutyCalendar  DutyCalendarDay[]

  @@map("schools")
}

model SchoolTheme {
  id              String  @id @default(cuid())
  schoolId        String  @unique
  school          School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  primaryColor    String  @default("#1a73e8")
  secondaryColor  String  @default("#ffffff")
  backgroundColor String  @default("#0f0f1a")
  fontFamily      String  @default("Heebo")
  logoUrl         String?
  borderRadius    Int     @default(8)

  @@map("school_themes")
}

model Screen {
  id                String                   @id @default(cuid())
  schoolId          String
  school            School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  slug              String                   @unique
  shortCode         String?                  @unique
  orientation       Orientation              @default(LANDSCAPE)
  width             Int                      @default(1920)
  height            Int                      @default(1080)
  active            Boolean                  @default(true)
  refreshSecs       Int                      @default(300)
  // Last snapshot captured in the screen editor ("עדכן צילום"): a versioned image URL and when it
  // was taken. Both empty until the first capture; the screens list falls back to the schematic.
  snapshotUrl       String?
  snapshotAt        DateTime?
  // Last heartbeat from the public display page (server time); null = never connected. One value
  // per screen, no history (see src/lib/screenConnection.ts).
  lastSeenAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  operatingSchedule ScreenOperatingSchedule?
  pairingCodes      ScreenPairingCode[]

  layout        ScreenLayout?
  sections      ScreenSection[]
  announcements AnnouncementScreen[]

  @@map("screens")
}

model ScreenLayout {
  id       String @id @default(cuid())
  screenId String @unique
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  // Header — NEW: height + date type
  headerEnabled         Boolean @default(true)
  headerHeight          Int     @default(80) // px — 60/80/100/120
  headerShowLogo        Boolean @default(true)
  headerShowTitle       Boolean @default(true)
  headerShowClock       Boolean @default(true)
  headerShowDate        Boolean @default(true)
  headerShowHebDate     Boolean @default(true)
  headerDateType        String  @default("BOTH") // HEBREW | GREGORIAN | BOTH
  headerShowWeather     Boolean @default(false)
  headerScrollText      String?
  headerTitleFontSize   Int     @default(26)
  headerTitleFontWeight Int     @default(700)
  headerShowParasha     Boolean @default(false)

  mainSections Int @default(1)

  // Footer — NEW: height + birthdays
  footerEnabled           Boolean @default(true)
  footerHeight            Int     @default(48) // px — 40/48/60/72
  footerTicker            String?
  footerShowSchoolName    Boolean @default(true)
  footerShowClock         Boolean @default(false)
  footerShowBirthdays     Boolean @default(false)
  /// Birthday segment of the footer ticker (see lib/birthdayDisplay.ts): ALL | STUDENT | TEACHER
  footerBirthdayAudience   String   @default("ALL")
  /// today | next7 | week | month
  footerBirthdayPeriod     String   @default("today")
  /// Canonical student grades; empty = all grades (teachers are never filtered by grade)
  footerBirthdayGrades     String[] @default([])
  /// first | full
  footerBirthdayNameFormat String   @default("first")
  footerFeedMode          String  @default("manual")
  footerRssUrl            String?
  footerRssMaxItems       Int     @default(8)
  footerRssRefreshMinutes Int     @default(15)
  footerTickerSpeed       String  @default("normal")

  bgColor    String?
  bgImageUrl String?
  fontFamily String  @default("Heebo")

  @@map("screen_layouts")
}

model ScreenSection {
  id       String @id @default(cuid())
  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  position Int
  widthPct Int    @default(100)
  /// Region background (lib/regionBackground.ts): theme default when null
  background Json?

  contentItems ContentItem[]

  @@unique([screenId, position])
  @@map("screen_sections")
}

model ContentItem {
  id          String        @id @default(cuid())
  sectionId   String
  section     ScreenSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contentType ContentType   @default(TEXT)
  priority    Int           @default(0)
  active      Boolean       @default(true)

  startDate  DateTime?
  endDate    DateTime?
  startTime  String?
  endTime    String?
  daysOfWeek Int[]

  textContent String?
  textColor   String?
  bgColor     String?
  fontSize    Int?

  galleryId       String?
  gallery         Gallery? @relation(fields: [galleryId], references: [id])
  slideDuration   Int      @default(5)
  transitionStyle String   @default("fade")

  videoUrl   String?
  videoLoop  Boolean @default(true)
  videoMuted Boolean @default(true)

  rssUrl      String?
  rssMaxItems Int     @default(5)

  weatherCity  String?
  weatherUnits String  @default("metric")

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("content_items")
}

model Announcement {
  id                     String   @id @default(cuid())
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title                  String
  showTitle              Boolean  @default(true)
  body                   String
  priority               Priority @default(LOW)
  bgColor                String   @default("#1a1a2e")
  textColor              String   @default("#ffffff")
  icon                   String?
  attachmentDisplayMode  String   @default("slideshow") // together | slideshow
  attachmentSlideSeconds Int      @default(8)
  active                 Boolean  @default(true)
  startAt                DateTime
  endAt                  DateTime
  startTime              String?
  endTime                String?
  daysOfWeek             Int[]
  isEmergency            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  screens     AnnouncementScreen[]
  attachments AnnouncementAttachment[]

  @@map("announcements")
}

// Attachments belong to announcements, not the general media gallery.
// A PDF's display pages are stored as separate IMAGE entries with parentPdfId.
model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  kind           String // IMAGE | PDF | PDF_PAGE
  url            String
  originalName   String
  mimeType       String
  sortOrder      Int          @default(0)
  parentPdfId    String?
  createdAt      DateTime     @default(now())

  @@index([announcementId, sortOrder])
  @@map("announcement_attachments")
}

model AnnouncementScreen {
  announcementId  String
  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  screenId        String
  screen          Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  sectionPosition Int?

  @@id([announcementId, screenId])
  @@map("announcement_screens")
}

model MediaFile {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  galleryId    String?
  gallery      Gallery?  @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  filename     String
  originalName String
  mimeType     String
  size         Int
  mediaType    MediaType
  url          String
  caption      String?
  hidden       Boolean   @default(false)
  uploadedAt   DateTime  @default(now())

  @@map("media_files")
}

// Gallery = album/folder for images
model Gallery {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files        MediaFile[]
  contentItems ContentItem[]

  @@map("galleries")
}

model ScreenOperatingSchedule {
  screenId    String   @id
  enabled     Boolean  @default(false)
  startTime   String   @default("07:00")
  endTime     String   @default("19:00")
  days        Int[]    @default([0, 1, 2, 3, 4])
  standbyMode String   @default("logo")
  updatedAt   DateTime @default(now()) @updatedAt

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@map("ScreenOperatingSchedule")
}

model ScreenPairingCode {
  id        String    @id @default(cuid())
  screenId  String
  screen    Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([screenId, expiresAt])
  @@map("screen_pairing_codes")
}

model PairingRateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime

  @@map("pairing_rate_limits")
}

// ── Birthday management ─────────────────────────────────────────────────────────────────────────
// People of a school (students and teachers) whose birthdays may be shown on screens. Personal data,
// including minors: managed only by SCHOOL_ADMIN and up, always scoped to one school, never sent to
// public screens as is (see src/lib/people/*).

enum PersonRoleType {
  STUDENT
  TEACHER
}

enum PersonGender {
  MALE
  FEMALE
}

/// Where a person's data comes from. Precedence for imports: SMARTSCHOOL > EXCEL > MANUAL.
enum PersonSourceType {
  MANUAL
  EXCEL
  SMARTSCHOOL
}

enum PersonSourceStatus {
  ACTIVE
  MISSING
  INACTIVE
}

model Person {
  id                 String           @id @default(cuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  /// Date only (no time, no time zone). Read with UTC getters; the year is internal only.
  birthDate          DateTime         @db.Date
  gender             PersonGender?
  /// Keyed HMAC-SHA256 of the normalized external identifier (e.g. ת״ז), scoped to the school.
  /// The raw identifier is never stored. Null for people added without an identifier.
  identityKey        String?
  identityKeyVersion Int?
  /// The identifier's last 3 characters, so admins can tell people with the same name apart.
  identityHint       String?
  active             Boolean          @default(true)
  deactivatedAt      DateTime?
  /// The source that last wrote the core fields (names, birth date, gender); see sourcePrecedence.
  dataSource         PersonSourceType @default(MANUAL)
  lastSyncedAt       DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  roles   PersonRole[]
  sources PersonSource[]

  @@unique([schoolId, identityKey])
  @@index([schoolId, active])
  @@index([schoolId, lastName, firstName])
  @@map("people")
}

/// A person's role in the school. One row per role, so a person can be both student and teacher
/// (or change role) without being duplicated.
model PersonRole {
  id        String         @id @default(cuid())
  personId  String
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      PersonRoleType
  /// Students: canonical grade (e.g. "ט׳"), parallel number and display class (e.g. "ט׳ 2").
  grade     String?
  parallel  Int?
  className String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([personId, role])
  @@index([role, grade])
  @@map("person_roles")
}

/// A record of a person in one data source. recordKey identifies the record within the source:
/// "manual:<personId>" for manual entries, a keyed HMAC of the source's record identifier otherwise.
model PersonSource {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  personId       String
  person         Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  sourceType     PersonSourceType
  recordKey      String
  status         PersonSourceStatus @default(ACTIVE)
  lastSeenAt     DateTime?
  lastImportedAt DateTime?
  /// The import (person_imports.id) that last saw this record, for Excel and other batch sources.
  lastImportId   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([schoolId, sourceType, recordKey])
  @@index([personId])
  @@map("person_sources")
}

enum PersonAuditAction {
  CREATED
  UPDATED
  ROLE_ADDED
  ROLE_CHANGED
  DEACTIVATED
  REACTIVATED
  IDENTITY_SET
  IDENTITY_REPLACED
  IDENTITY_REMOVED
}

/// Who changed which person record, and how. Written in the same transaction as the change.
/// metadata holds only field names and role types — never names, dates or identifiers.
/// personId has no foreign key on purpose: the trail outlives the person record.
model PersonAuditEvent {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  personId  String
  actorId   String?
  action    PersonAuditAction
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([schoolId, createdAt])
  @@index([personId, createdAt])
  @@map("person_audit_events")
}

enum PersonImportStatus {
  PREVIEWED
  APPLYING
  APPLIED
  FAILED
  EXPIRED
}

/// One spreadsheet import: created by the preview, applied once after confirmation, then kept as a
/// record of the batch. rows holds the normalized rows needed to apply it (keyed identities only —
/// never raw identifiers) and is cleared when the import is applied, cancelled or expired.
model PersonImport {
  id          String             @id @default(cuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdById String
  kind        PersonRoleType
  status      PersonImportStatus @default(PREVIEWED)
  fileName    String
  fileSha256  String
  sheetName   String
  rows        Json?
  planHash    String
  summary     Json
  error       String?
  expiresAt   DateTime
  appliedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([schoolId, createdAt])
  @@index([schoolId, fileSha256])
  @@map("person_imports")
}

// ── Duty roster (תורנויות) ─────────────────────────────────────────────────────
// Staff supervision duties per school. The weekly roster is edited as a draft (DutyAssignment rows);
// publishing stores a snapshot on DutyWeek, and only that snapshot is ever shown on screens.
// Absences and approved substitutions are operational records applied over the published snapshot.

/// Access to the duty roster, separate from the screen role. SCHOOL_ADMIN and SUPER_ADMIN always
/// have PUBLISH; other users have only what is granted here (NONE by default).
enum DutyAccess {
  NONE
  VIEW
  EDIT
  PUBLISH
}

enum DutyDataSource {
  MANUAL
  SMARTSCHOOL
}

/// REGULAR: the school's permanent staff (manual or synced). MANUAL: added by hand for the roster only
/// (not in the school directory). TEMPORARY: a temporary or external person (substitute, instructor,
/// guest), usually with validFrom/validUntil. MANUAL and TEMPORARY records are never sent to or
/// replaced by an external directory sync.
/// How a school plans its roster by default (the same engine for all three):
/// WEEKLY – each week is planned on its own (copy last week / a template);
/// RECURRING – a fixed weekly template applies automatically, with date-specific changes;
/// HYBRID – the template is the baseline and weeks are adjusted freely (same data, other defaults).
enum DutyScheduleMode {
  WEEKLY
  RECURRING
  HYBRID
}

/// A calendar exception: no duties (holiday / no school) or an extra school day.
enum DutyDayKind {
  HOLIDAY
  NO_SCHOOL
  SPECIAL
}

enum DutyStaffKind {
  REGULAR
  MANUAL
  TEMPORARY
}

/// A staff member who can be assigned duties. Optionally linked to the birthday directory (Person).
model DutyStaff {
  id          String         @id @default(cuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  personId    String?
  /// Identifier in an external system (future SmartSchool sync); unique per school when set.
  externalRef String?
  source      DutyDataSource @default(MANUAL)
  kind        DutyStaffKind  @default(REGULAR)
  /// Dates the person may be assigned (inclusive; null = open). Existing assignments are kept.
  validFrom   DateTime?      @db.Date
  validUntil  DateTime?      @db.Date
  /// false = archived: hidden from new assignments, kept in history.
  active      Boolean        @default(true)
  /// Personal limits (null = the school default from DutySettings, or no limit).
  maxPerDay   Int?
  maxPerWeek  Int?
  /// Times the person is not available: [{ "weekday": 0-6, "periodId": "..." | null }] (null = whole day).
  unavailable Json?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  assignments   DutyAssignment[]
  absences      DutyAbsence[]
  substitutions DutySubstitution[]

  @@unique([schoolId, externalRef])
  @@index([schoolId, active])
  @@map("duty_staff")
}

model DutyLocation {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  /// Whether the location must be covered in every period.
  required    Boolean  @default(true)
  /// How many staff members the location needs at once.
  staffNeeded Int      @default(1)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments DutyAssignment[]

  @@index([schoolId, active])
  @@map("duty_locations")
}

/// A duty period (e.g. a break): school-local times on the given weekdays (0 = Sunday).
model DutyPeriod {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startTime String
  endTime   String
  weekdays  Int[]
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DutyAssignment[]
  absences    DutyAbsence[]

  @@index([schoolId, active])
  @@map("duty_periods")
}

/// School-level rules. Every limit is optional: nothing is enforced unless configured.
model DutySettings {
  id            String   @id @default(cuid())
  schoolId      String   @unique
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// School days (0 = Sunday … 6 = Saturday).
  schoolDays    Int[]    @default([0, 1, 2, 3, 4, 5])
  maxPerDay     Int?
  maxPerWeek    Int?
  /// Whether a rule violation may be saved with a written reason (by users who may edit).
  allowOverride Boolean  @default(true)
  scheduleMode  DutyScheduleMode @default(WEEKLY)
  updatedAt     DateTime @updatedAt

  @@map("duty_settings")
}

/// One school week (weekStart = its Sunday, a date). Holds the published snapshot.
model DutyWeek {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  weekStart        DateTime  @db.Date
  /// The published roster (DutyPublishedEntry[], see src/lib/duty/types.ts). Null until published.
  published        Json?
  publishedAt      DateTime?
  publishedById    String?
  /// Bumped on every draft change; equal to publishedVersion when nothing is unpublished.
  draftVersion     Int       @default(0)
  publishedVersion Int       @default(0)
  /// Whether the week follows the recurring template (null = the school's schedule mode decides).
  useTemplate      Boolean?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignments DutyAssignment[]

  @@unique([schoolId, weekStart])
  @@map("duty_weeks")
}

/// A draft assignment: one staff member at one location in one period on one date.
model DutyAssignment {
  id             String       @id @default(cuid())
  schoolId       String
  weekId         String
  week           DutyWeek     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  periodId       String
  period         DutyPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  locationId     String
  location       DutyLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staffId        String
  staff          DutyStaff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Set when saved despite a rule violation (with the user who confirmed it).
  overrideReason String?
  overrideById   String?
  createdById    String?
  createdAt      DateTime     @default(now())
  /// Set when this row replaces one template occurrence on its date (a one-time change).
  overrideOfEntryId String?
  overrideOf        DutyTemplateEntry? @relation(fields: [overrideOfEntryId], references: [id], onDelete: SetNull)

  substitutions DutySubstitution[]

  @@unique([weekId, date, periodId, locationId, staffId])
  @@index([schoolId, date])
  @@map("duty_assignments")
}

model DutyAbsence {
  id          String         @id @default(cuid())
  schoolId    String
  staffId     String
  staff       DutyStaff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  /// Null = the whole day.
  periodId    String?
  period      DutyPeriod?    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  reason      String?
  source      DutyDataSource @default(MANUAL)
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([schoolId, date])
  @@map("duty_absences")
}

/// A substitute for one assignment on its date. The original assignment stays unchanged.
model DutySubstitution {
  id                String          @id @default(cuid())
  schoolId          String
  /// The week assignment replaced (null for a template occurrence, see occurrenceKey).
  assignmentId      String?
  assignment        DutyAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// The occurrence replaced: the assignment id, or "t:<templateEntryId>:<YYYY-MM-DD>".
  occurrenceKey     String?
  substituteStaffId String
  substitute        DutyStaff      @relation(fields: [substituteStaffId], references: [id], onDelete: Cascade)
  approvedById      String?
  approvedAt        DateTime       @default(now())
  /// Cancelled substitutions are kept for history.
  cancelledAt       DateTime?
  cancelledById     String?

  @@index([schoolId, assignmentId])
  @@index([schoolId, occurrenceKey])
  @@map("duty_substitutions")
}

model DutyAuditEvent {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@map("duty_audit_events")
}

/// A recurring weekly roster, valid from effectiveFrom to effectiveUntil (inclusive; null = open).
/// A change "from date X on" ends this version the day before X and starts a new version, so past
/// weeks keep the template they had. Template occurrences are computed, never stored per date.
model DutyTemplate {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  entries DutyTemplateEntry[]

  @@index([schoolId, effectiveFrom])
  @@map("duty_templates")
}

/// One recurring duty: a person at a location in a period on a weekday (0 = Sunday).
model DutyTemplateEntry {
  id         String       @id @default(cuid())
  schoolId   String
  templateId String
  template   DutyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weekday    Int
  periodId   String
  locationId String
  staffId    String
  createdAt  DateTime     @default(now())

  skips     DutyTemplateSkip[]
  overrides DutyAssignment[]

  @@unique([templateId, weekday, periodId, locationId, staffId])
  @@index([schoolId])
  @@map("duty_template_entries")
}

/// A template occurrence that does not apply on one date (cancelled or replaced by a week row).
model DutyTemplateSkip {
  id          String            @id @default(cuid())
  schoolId    String
  entryId     String
  entry       DutyTemplateEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  date        DateTime          @db.Date
  createdById String?
  createdAt   DateTime          @default(now())

  @@unique([entryId, date])
  @@index([schoolId, date])
  @@map("duty_template_skips")
}

model DutyCalendarDay {
  id        String      @id @default(cuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  kind      DutyDayKind
  name      String
  createdAt DateTime    @default(now())

  @@unique([schoolId, date])
  @@map("duty_calendar_days")
}
